# Copy this file to .env and fill in your keys.

# ── Required ─────────────────────────────────────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (recommended) ────────────────────────────────
# Free HuggingFace token for semantic search embeddings.
# Without this, the app still works but uses BM25 keyword search.
# Get yours free at: https://huggingface.co/settings/tokens
# (No credit card needed — click "New token" → type "read")
HF_TOKEN=your_hf_token_here
